{
  "manifest_version": 3,
  "name": "Mute Defaults",
  "short_name": "Mute Defaults",
  "description": "This extension lets you set default mute settings for your microphone and camera in google meet.",
  "version": "3.1",
  "author": "ADomingos",
  "homepage_url": "https://github.com/a-domingos/MuteDefaults",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "settings.html",
    "default_title": "Manage microphone and camera settings on google meet"
  },
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": [
        "*://meet.google.com/*"
      ],
      "js": ["hook_hangouts.js"]
    }
  ],
  "permissions": [
    "storage"
  ]
}
